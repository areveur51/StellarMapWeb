# ====================
# Django Core Settings
# ====================
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-secure-one
DEBUG=True
DJANGO_SETTINGS_MODULE=StellarMapWeb.settings.settings_base

# NAS / always-on (stellarmapctl): prefer LIGHT_MODE=1, DEBUG=False
# LIGHT_MODE=1
# DEBUG=False
# POLL_INTERVAL_MS=60000
# PENDING_ACCOUNTS_LIMIT=50
# CACHE_MAX_ENTRIES=256

# Lineage aggregation (design-lineage-aggregation.md)
# When 1: pipelines write full search-cache projection on complete (DB-only rebuild)
# LINEAGE_WRITE_PROJECTION=0
# When 1: search_view uses unified projection for table + tree (one aggregation)
# LINEAGE_UNIFIED_AGGREGATE=0
# When 1: SSR includes siblings in projection (heavier; usually leave off on NAS)
# LINEAGE_SSR_INCLUDE_SIBLINGS=0
# Process-local lineage API response LRU (default on)
# LINEAGE_API_RESPONSE_CACHE=1
# When 1: search UI path-first then siblings second request (optional PR5)
# LINEAGE_PROGRESSIVE_SIBLINGS=0

# Production: Set DEBUG=False and use production settings
# DJANGO_SETTINGS_MODULE=StellarMapWeb.settings.production

# ====================
# Security Settings (Production)
# ====================
# Comma-separated list of allowed hosts (production only)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# SSL/HTTPS Settings (set to False for local development)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Production: Enable these for HTTPS
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ====================
# Database Settings
# ====================
# Astra DB (Cassandra) - Required for production
ASTRA_DB_TOKEN=your-astra-db-token-here
CASSANDRA_DB_NAME=stellarmapwebastradb
CASSANDRA_KEYSPACE=stellarmapweb_keyspace
# Lab: ENV=development but read Astra with a read-only token (no pipeline writes)
# CASSANDRA_READ_ONLY=1

# ====================
# Cache Settings (Optional)
# ====================
# Redis URL for production caching (leave empty for local memory cache)
REDIS_URL=

# ====================
# Email Settings (Optional)
# ====================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@stellarmapweb.com
SERVER_EMAIL=server@stellarmapweb.com

# Admin email for error notifications
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@stellarmapweb.com

# ====================
# Error Monitoring (Optional)
# ====================
SENTRY_DSN=

# ====================
# Logging
# ====================
DJANGO_LOG_LEVEL=INFO


# ====================
# Manager auth (Tailscale QR)
# ====================
# Public search/read needs no login. Managers only:
# AUTH_MODE=tailscale-qr,local
# TAILSCALE_ALLOW_LOGINS=you@example.com,other@example.com
# TAILSCALE_SOCKET=/volume6/@appdata/Tailscale/tailscaled.sock
# SESSION_IDLE_HOURS=8
# SESSION_COOKIE_NAME=stellarmap.sid

# ====================
# Database (optional Postgres)
# ====================
# DATABASE_DRIVER=sqlite
# DATABASE_DRIVER=pg
# DATABASE_URL=postgres://stellarmap:CHANGE_ME@127.0.0.1:5433/StellarMapDB
